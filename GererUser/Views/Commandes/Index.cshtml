@model IEnumerable<GestionUsersMVC.Models.Commande>

@{
    ViewData["Title"] = "Gestion des Commandes";
}

<div class="container mt-4">
    @* --- BLOC BOUTON RETOUR --- *@
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 shadow-sm border-2">
            <i class="fas fa-arrow-left me-2"></i>Retour à l'accueil
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fas fa-file-invoice-dollar text-warning me-2"></i> Historique des Commandes</h2>
        <span class="badge bg-dark px-3 py-2">Total : @Model.Count() commandes</span>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Client</th>
                        <th>Articles</th> @* Nouvelle colonne *@
                        <th>Contact & Adresse</th>
                        <th class="text-end">Montant</th>
                        <th class="text-center pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="text-muted small">@item.DateCommande.ToString("dd/MM/yyyy")</span>
                                <div class="fw-bold" style="font-size: 0.85rem;">@item.DateCommande.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Nom @item.Prenom</div>
                            </td>
                            <td>
                                @* --- AFFICHAGE DES ARTICLES --- *@
                                @if (item.Articles != null && item.Articles.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1" style="max-width: 300px;">
                                        @foreach (var art in item.Articles)
                                        {
                                            <span class="badge bg-info text-dark fw-normal border" style="font-size: 0.7rem;">
                                                <i class="fas fa-tag me-1 text-primary"></i>@art.Titre
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Aucun article</span>
                                }
                            </td>
                            <td>
                                <div class="small">
                                    <i class="fas fa-envelope me-1 text-muted"></i> @item.Email
                                </div>
                                <div class="small text-muted mt-1" style="max-width: 200px; line-height: 1.2;">
                                    <i class="fas fa-map-marker-alt me-1 opacity-50"></i> @item.Adresse
                                </div>
                            </td>
                            <td class="text-end fw-bold text-primary">@item.Total.ToString("N2") €</td>
                            <td class="text-center pe-4">
                                <a asp-controller="Commandes" asp-action="ALivrer" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-success rounded-pill px-3 fw-bold shadow-sm"
                                   onclick="return confirm('Marquer cette commande comme livrée ?')">
                                    <i class="fas fa-check me-1"></i> À livrer
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .btn-outline-dark {
        transition: all 0.3s ease;
    }

        .btn-outline-dark:hover {
            transform: translateX(-5px);
            background-color: #212529;
            color: #fff;
        }

    .card {
        border-radius: 12px;
    }

    .table thead th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        color: #6c757d;
        padding: 15px;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(255, 193, 7, 0.05) !important;
    }

    .badge.bg-info {
        background-color: #e1f5fe !important;
        border-color: #b3e5fc !important;
    }
</style>