@model GestionUsersMVC.Models.Article

@{
    // CORRECTION : On utilise Model.Titre au lieu de Model.Nom
    ViewData["Title"] = "Supprimer " + Model.Titre;
}

<h1>Supprimer</h1>

<h3 class="text-danger">Êtes-vous sûr de vouloir supprimer cet article ? Cela supprimera aussi l'image associée.</h3>

<div>
    @* CORRECTION : Model.Titre *@
    <h4>Article : @Model.Titre</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-4">
            @* CORRECTION : model.Titre *@
            Titre
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.Titre)
        </dd>

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.Prix)
        </dt>
        <dd class="col-sm-8">
            @Model.Prix.ToString("C")
        </dd>

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.DescriptionCourte)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.DescriptionCourte)
        </dd>

        <dt class="col-sm-4">
            Image :
        </dt>
        <dd class="col-sm-8">
            @if (!string.IsNullOrEmpty(Model.NomFichierImage))
            {
                <img src="~/images/@Model.NomFichierImage" alt="@Model.Titre" style="max-width: 100px; height: auto;" />
            }
            else
            {
                <span>Aucune image</span>
            }
        </dd>

        <dt class="col-sm-4">
            @Html.DisplayNameFor(model => model.NoteMoyenne)
        </dt>
        <dd class="col-sm-8">
            @Html.DisplayFor(model => model.NoteMoyenne) / 5.0
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirmer la Suppression" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </form>
</div>