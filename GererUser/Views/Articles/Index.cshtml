
@model IEnumerable<GestionUsersMVC.Models.Article>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-microscope text-primary"></i> Inventaire ScienceStore</h1>
        <a asp-action="Create" class="btn btn-success shadow-sm"><i class="fas fa-plus"></i> Ajouter un article</a>
    </div>

    <div class="card p-3 shadow-sm border-0 bg-light mb-4">
        <div class="row g-3">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="liveSearch" class="form-control" placeholder="Rechercher par titre...">
                </div>
            </div>
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-tag text-muted"></i></span>
                    <select id="filterDomaine" class="form-select">
                        <option value="">Tous les domaines</option>
                        @foreach (var d in ViewBag.Domaines)
                        {
                            <option value="@d">@d</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">Aperçu</th>
                        <th>Titre</th>
                        <th>Domaine</th>
                        <th>Prix</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <partial name="ArticlesTableBody" model="Model" />
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            function performFilter() {
                const searchVal = $("#liveSearch").val();
                const domaineVal = $("#filterDomaine").val();

                $.ajax({
                    url: '@Url.Action("Index", "Articles")',
                    type: 'GET',
                    data: { q: searchVal, domaine: domaineVal },
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (html) {
                        $("#tableBody").html(html);
                    }
                });
            }

            $("#liveSearch").on("keyup", performFilter);
            $("#filterDomaine").on("change", performFilter);
        });
    </script>
}