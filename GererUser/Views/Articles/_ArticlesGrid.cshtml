@model IEnumerable<GestionUsersMVC.Models.Article>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <i class="fas fa-search fa-3x text-muted mb-3"></i>
            <p class="lead text-muted">Aucun article ne correspond à votre recherche.</p>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative transition-hover">
                    <span class="position-absolute top-0 end-0 badge rounded-pill bg-warning text-dark m-2 shadow-sm">
                        @item.Domaine
                    </span>

                    @if (!string.IsNullOrEmpty(item.NomFichierImage))
                    {
                        <img src="~/images/@item.NomFichierImage"
                             class="card-img-top"
                             style="height:200px; object-fit:cover;"
                             alt="@item.Titre">
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height:200px;">
                            <i class="fas fa-flask fa-3x text-muted opacity-25"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark">
                            @item.Titre
                        </h5>

                        <div class="text-warning mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="@(i <= item.NoteMoyenne ? "fas" : "far") fa-star fa-xs"></i>
                            }
                        <span class="text-muted small ms-1">(@item.NoteMoyenne)</span>
                    </div>

                    <p class="card-text text-muted small flex-grow-1">
                        @(item.DescriptionCourte?.Length > 100
                                            ? item.DescriptionCourte.Substring(0, 100) + "..."
                                            : item.DescriptionCourte)
                </p>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="h5 mb-0 text-primary fw-bold">@item.Prix.ToString("C2")</span>

                            <div class="btn-group">
                                @* Bouton Ajouter au Panier (Nouveau) *@
                                <button onclick="ajouterAuPanier(@item.Id)" class="btn btn-sm btn-dark px-3">
                                    <i class="fas fa-cart-plus"></i>
                                </button>

                                <a asp-controller="Articles" asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary px-3">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <form asp-controller="Articles" asp-action="Delete" asp-route-id="@item.Id"
                                      method="post" onsubmit="return confirm('Supprimer cet article ?');" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3 rounded-end-pill">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@* --- BLOC DE NAVIGATION / PAGINATION --- *@
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Navigation des produits" class="mt-5">
        <ul class="pagination justify-content-center">
            @* Bouton Précédent *@
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <button class="page-link border-0 shadow-sm mx-1 rounded-pill"
                        onclick="filter(@(ViewBag.CurrentPage - 1))">
                    <i class="fas fa-chevron-left"></i>
                </button>
            </li>

            @* Numéros de pages *@
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <button class="page-link border-0 shadow-sm mx-1 rounded-circle @(i == ViewBag.CurrentPage ? "" : "bg-white text-dark")"
                            style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;"
                            onclick="filter(@i)">
                        @i
                    </button>
                </li>
            }

            @* Bouton Suivant *@
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <button class="page-link border-0 shadow-sm mx-1 rounded-pill"
                        onclick="filter(@(ViewBag.CurrentPage + 1))">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </li>
        </ul>
    </nav>
}

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    /* Styles pour la pagination active */
    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        color: white;
        font-weight: bold;
    }

    .pagination .page-link:hover:not(.active) {
        background-color: #f8f9fa;
        color: #0d6efd;
    }

    /* Harmonisation du groupe de boutons */
    .btn-group .btn-dark {
        border-top-left-radius: 50px !important;
        border-bottom-left-radius: 50px !important;
    }
</style>