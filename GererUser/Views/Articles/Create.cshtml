@model ScienceStore.Models.ArticleViewModel

@{
    ViewData["Title"] = "Laboratoire - Nouvel Article";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                @* Header *@
                <div class="card-header bg-dark text-white py-4 border-0">
                    <div class="d-flex align-items-center justify-content-between px-3">
                        <div>
                            <h3 class="fw-bold mb-0 text-warning">
                                <i class="fas fa-flask-vial me-2"></i>Nouveau Spécimen
                            </h3>
                            <p class="text-white-50 small mb-0">Enregistrement d'un nouvel article dans la base de données.</p>
                        </div>
                        <i class="fas fa-microscope fa-3x opacity-25"></i>
                    </div>
                </div>

                <div class="card-body p-5 bg-white">
                    <form asp-action="Create" enctype="multipart/form-data" class="needs-validation">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="row g-4">
                            @* Nom *@
                            <div class="col-12">
                                <label asp-for="Nom" class="form-label fw-bold text-dark">Désignation de l'article</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-tag"></i></span>
                                    <input asp-for="Nom" class="form-control border-start-0 ps-0 border-focus-warning" placeholder="Ex: Microscope Électronique X500" />
                                </div>
                                <span asp-validation-for="Nom" class="text-danger small"></span>
                            </div>

                            @* Domaine *@
                            <div class="col-md-6">
                                <label asp-for="Domaine" class="form-label fw-bold text-dark">Domaine Scientifique</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-atom"></i></span>
                                    <select asp-for="Domaine" class="form-select border-start-0 ps-0" asp-items="ViewBag.DomaineChoices">
                                        <option value="">-- Catégorie --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Domaine" class="text-danger small"></span>
                            </div>

                            @* Prix *@
                            <div class="col-md-6">
                                <label asp-for="Prix" class="form-label fw-bold text-dark">Valeur Marchande</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-euro-sign"></i></span>
                                    <input asp-for="Prix" class="form-control border-start-0 ps-0" type="number" step="0.01" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Prix" class="text-danger small"></span>
                            </div>

                            @* Note *@
                            <div class="col-md-6">
                                <label asp-for="NoteMoyenne" class="form-label fw-bold text-dark">Évaluation (0 à 5)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-star"></i></span>
                                    <input asp-for="NoteMoyenne" class="form-control border-start-0 ps-0" type="number" step="0.1" min="0" max="5" />
                                </div>
                                <span asp-validation-for="NoteMoyenne" class="text-danger small"></span>
                            </div>

                            @* Image *@
                            <div class="col-md-6">
                                <label asp-for="FichierImage" class="form-label fw-bold text-dark">Iconographie (Image)</label>
                                <input asp-for="FichierImage" type="file" class="form-control custom-file-input" accept="image/*" />
                                <span asp-validation-for="FichierImage" class="text-danger small"></span>
                            </div>

                            @* Description Courte *@
                            <div class="col-12">
                                <label asp-for="DescriptionCourte" class="form-label fw-bold text-dark">Résumé (Description courte)</label>
                                <input asp-for="DescriptionCourte" class="form-control" placeholder="Bref aperçu de l'article..." />
                                <span asp-validation-for="DescriptionCourte" class="text-danger small"></span>
                            </div>

                            @* --- NOUVEAU : DESCRIPTION COMPLÈTE --- *@
                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-bold text-dark">Description Détaillée (Complète)</label>
                                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Saisissez ici tous les détails techniques, l'histoire ou le fonctionnement du produit..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        @* Boutons *@
                        <div class="d-flex justify-content-end gap-3 mt-5">
                            <a asp-controller="Articles" asp-action="IndexM" class="btn btn-light px-4 rounded-pill border fw-bold text-muted">
                                <i class="fas fa-arrow-left me-2"></i>Retour
                            </a>
                            <button type="submit" class="btn btn-warning px-5 rounded-pill fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-2"></i>Confirmer l'ajout
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    footer {
        display: none !important;
    }

    body {
        background: linear-gradient(135deg, #f4f7f9 0%, #d1d9e6 100%);
        min-height: 100vh;
    }

    .form-control:focus, .form-select:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.15);
    }

    .custom-file-input::-webkit-file-upload-button {
        background: #212529;
        color: white;
        border: none;
        padding: 5px 15px;
        border-radius: 5px;
        margin-right: 10px;
        cursor: pointer;
    }

    .form-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #495057;
    }

    .btn-warning:hover {
        background-color: #e0a800;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(224, 168, 0, 0.3);
    }
</style>