@using GestionUsersMVC.Models
@{
    ViewData["Title"] = "Inscription - ScienceStore";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-orange: #FFA500;
            --science-blue: #FFA500;
            --bg-light: #f4f7f9;
        }

        body {
            background-color: var(--bg-light);
            background-image: radial-gradient(#d1d9e6 1px, transparent 1px);
            background-size: 30px 30px;
            margin: 0;
            font-family: 'Poppins', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .register-card {
            background-color: #ffffff;
            padding: 35px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            width: 100%;
            max-width: 500px;
            border: none;
            position: relative;
            text-align: center;
        }

            /* Barre de progression/dégradé en haut */
            .register-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 6px;
                background: linear-gradient(to right, var(--primary-orange), var(--science-blue));
                border-radius: 20px 20px 0 0;
            }

            .register-card h2 {
                color: #333;
                font-size: 1.5rem;
                margin-bottom: 5px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .register-card p {
                color: #888;
                font-size: 0.85rem;
                margin-bottom: 25px;
            }

        .form-row {
            display: flex;
            gap: 15px;
        }

        .form-group {
            margin-bottom: 15px;
            position: relative;
            text-align: left;
            flex: 1;
        }

            .form-group label {
                font-size: 0.75rem;
                font-weight: 600;
                color: #666;
                margin-bottom: 5px;
                display: block;
                padding-left: 5px;
            }

            .form-group i {
                position: absolute;
                left: 15px;
                bottom: 12px;
                color: #ccc;
                transition: color 0.3s;
            }

            .form-group input, .form-group select {
                width: 100%;
                padding: 10px 15px 10px 40px;
                background-color: #f8f9fa;
                border: 2px solid #eee;
                border-radius: 10px;
                color: #333;
                font-size: 0.9rem;
                box-sizing: border-box;
                transition: all 0.3s ease;
            }

                .form-group input:focus, .form-group select:focus {
                    outline: none;
                    border-color: var(--science-blue);
                    background-color: #fff;
                    box-shadow: 0 0 8px rgba(0, 123, 255, 0.1);
                }

                    .form-group input:focus + i {
                        color: var(--science-blue);
                    }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #333 0%, #000 100%);
            border: none;
            border-radius: 12px;
            color: white;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 15px;
            text-transform: uppercase;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
                filter: brightness(1.2);
            }

        .error-text {
            background-color: #fff5f5;
            color: #e53e3e;
            padding: 10px;
            border-radius: 8px;
            margin-top: 15px;
            font-size: 0.8rem;
            border-left: 4px solid #e53e3e;
            text-align: left;
        }

        .login-redirect {
            display: block;
            margin-top: 25px;
            color: #777;
            text-decoration: none;
            font-size: 0.85rem;
        }

            .login-redirect span {
                color: var(--science-blue);
                font-weight: 600;
            }

            .login-redirect:hover span {
                text-decoration: underline;
            }

        /* Responsive pour mobile */
        @@media (max-width: 480px) {
            .form-row {
                flex-direction: column;
                gap: 0;
            }
        }
    </style>
</head>
<body>

    <div class="register-card">
        <div style="margin-bottom: 15px;">
            <span style="background: #eef2ff; padding: 12px; border-radius: 50%; display: inline-block;">
                <i class="fas fa-user-plus fa-2x" style="color: var(--science-blue);"></i>
            </span>
        </div>
        <h2>Inscription</h2>
        <p>Rejoignez la communauté ScienceStore</p>

        <form method="post">
            <div class="form-row">
                <div class="form-group">
                    <label>Nom</label>
                    <input name="Nom" placeholder="Nom" required />
                    <i class="fas fa-id-card"></i>
                </div>
                <div class="form-group">
                    <label>Prénom</label>
                    <input name="Prenom" placeholder="Prénom" required />
                    <i class="fas fa-user"></i>
                </div>
            </div>

            <div class="form-group">
                <label>Adresse Email</label>
                <input name="Email" type="email" placeholder="chercheur@labo.fr" required />
                <i class="fas fa-envelope"></i>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Mot de passe</label>
                    <input name="MotDePasse" type="password" placeholder="••••••••" required />
                    <i class="fas fa-lock"></i>
                </div>
                <div class="form-group">
                    <label>Confirmation</label>
                    <input name="ConfirmPassword" type="password" placeholder="••••••••" required />
                    <i class="fas fa-shield-alt"></i>
                </div>
            </div>

            <div class="form-group">
                <label>Votre Grade / Rôle</label>
                <select name="Role" required>
                    <option value="" disabled selected>-- Sélectionnez --</option>
                    <option value="Etudiant">Étudiant</option>
                    <option value="Doctorant">Doctorant</option>
                    <option value="EnseignantChercheur">Enseignant Chercheur</option>
                    <option value="Evaluateur">Évaluateur</option>
                </select>
                <i class="fas fa-user-tag"></i>
            </div>

            <button type="submit" class="btn-submit">Créer le profil</button>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="error-text">
                <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Error
            </div>
        }

        <a href="/Account/Login" class="login-redirect">
           <span>Se connecter</span>
        </a>
    </div>

</body>
</html>