@model List<GestionUsersMVC.Models.Article>

@{
    ViewData["Title"] = "Mon Panier - ScienceStore";
}

<div class="container py-5">
    <div class="d-flex align-items-center justify-content-between mb-5">
        <h2 class="fw-bold mb-0">
            <i class="fas fa-shopping-cart text-warning me-3"></i>Votre Panier
        </h2>
        <span class="badge bg-dark rounded-pill px-4 py-2 fs-6">@Model.Count articles</span>
    </div>

    @if (Model.Count > 0)
    {
        <div class="row g-4">
            @* Colonne de gauche : Liste des produits *@
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th class="ps-4 py-3 border-0">Produit</th>
                                    <th class="py-3 border-0 text-center">Prix</th>
                                    <th class="pe-4 py-3 border-0 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="cart-row">
                                        <td class="ps-4 py-4">
                                            <div class="d-flex align-items-center">
                                                <img src="~/images/@item.NomFichierImage"
                                                     class="rounded-3 shadow-sm border border-2 border-warning border-opacity-10"
                                                     width="80" height="80"
                                                     style="object-fit: cover;" />
                                                <div class="ms-4">
                                                    <h6 class="fw-bold mb-1">@item.Titre</h6>
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 fw-bold">@item.Domaine</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center py-4">
                                            <span class="fw-bold fs-5 text-dark">@item.Prix.ToString("N2") €</span>
                                        </td>
                                        <td class="pe-4 py-4 text-end">
                                            <a asp-controller="Panier" asp-action="Supprimer" asp-route-id="@item.Id"
                                               class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 hover-delete">
                                                <i class="fas fa-trash-alt me-1"></i> Retirer
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-link text-decoration-none text-dark fw-bold px-0">
                        <i class="fas fa-arrow-left me-2 text-warning"></i>Continuer mes achats
                    </a>
                </div>
            </div>

            @* Colonne de droite : Résumé *@
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg rounded-4 p-4 sticky-top" style="top: 2rem; border-top: 5px solid #ffc107 !important;">
                    <h5 class="fw-bold mb-4">Résumé de la commande</h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Sous-total</span>
                        <span class="fw-bold">@Model.Sum(x => x.Prix).ToString("N2") €</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Livraison</span>
                        <span class="text-success fw-bold">Gratuite</span>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between align-items-center mb-5">
                        <span class="h5 fw-bold mb-0">TOTAL</span>
                        <span class="h3 fw-bold text-warning mb-0">@Model.Sum(x => x.Prix).ToString("N2") €</span>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="Commandes" asp-action="Checkout" class="btn btn-warning btn-lg fw-bold rounded-pill py-3 shadow">
                            FINALISER <i class="fas fa-check-circle ms-2"></i>
                        </a>
                    </div>

                   
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 card border-0 shadow-sm rounded-4">
            <div class="py-5">
                <i class="fas fa-shopping-basket fa-6x text-warning mb-4 opacity-25"></i>
                <h3 class="fw-bold">Votre panier est vide</h3>
                <p class="text-muted mb-4">Explorez notre catalogue pour trouver des spécimens incroyables.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-warning btn-lg rounded-pill px-5 fw-bold shadow">
                    Retour à la boutique
                </a>
            </div>
        </div>
    }
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .cart-row {
        transition: background-color 0.2s ease;
    }

        .cart-row:hover {
            background-color: #fffdf5;
        }

    .hover-delete:hover {
        background-color: #dc3545;
        color: white !important;
        border-color: #dc3545;
    }

    .card {
        transition: transform 0.3s ease;
    }
</style>