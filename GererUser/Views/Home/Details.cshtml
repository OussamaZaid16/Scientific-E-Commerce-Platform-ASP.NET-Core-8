@model GestionUsersMVC.Models.Article

@{
    ViewData["Title"] = "Détails - " + Model.Titre;
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Boutique</a></li>
                <li class="breadcrumb-item active">@Model.Domaine</li>
            </ol>
        </nav>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Retour au catalogue
            </a>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4 border-end">
                @if (!string.IsNullOrEmpty(Model.NomFichierImage))
                {
                    <img src="~/images/@Model.NomFichierImage"
                         class="img-fluid rounded-3 shadow-sm"
                         alt="@Model.Titre"
                         style="max-height: 450px; width: 100%; object-fit: cover;">
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="fas fa-flask fa-6x mb-3 opacity-25"></i>
                        <p class="small text-uppercase fw-bold">Image non disponible</p>
                    </div>
                }
            </div>

            <div class="col-md-7">
                <div class="card-body p-4 p-lg-5">
                    <div class="mb-3">
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">
                            <i class="fas fa-tag me-1"></i> @Model.Domaine
                        </span>
                        <span class="badge bg-light text-muted border px-3 py-2 rounded-pill ms-2">
                            <i class="fas fa-calendar-alt me-1"></i> @Model.Annee
                        </span>
                    </div>

                    <h1 class="card-title fw-bold text-dark display-6">@Model.Titre</h1>

                    <div class="d-flex align-items-center mb-4">
                        <div class="text-warning h5 mb-0 me-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="@(i <= Model.NoteMoyenne ? "fas" : "far") fa-star"></i>
                            }
                        </div>
                        <span class="text-muted fw-bold">(@Model.NoteMoyenne / 5)</span>
                    </div>

                    <h2 class="text-primary fw-bold mb-4">@Model.Prix.ToString("N2") €</h2>

                    <div class="bg-light rounded-3 p-3 mb-4 border-start border-primary border-4">
                        <h6 class="text-uppercase text-muted small fw-bold mb-2">En résumé</h6>
                        <p class="mb-0 fst-italic">@Model.DescriptionCourte</p>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted small fw-bold mb-2">Description complète</h6>
                        <p class="text-justify lh-lg" style="white-space: pre-line;">@Model.Description</p>
                    </div>

                    <hr class="my-4">

                    <div class="row align-items-center">
                        @* La colonne contenant l'auteur a été supprimée, le bouton "Ajouter au panier" est maintenant seul *@
                        <div class="col-12 text-end">
                            <a asp-controller="Panier"
                               asp-action="Ajouter"
                               asp-route-id="@Model.Id"
                               class="btn btn-success btn-lg px-5 rounded-pill shadow">
                                <i class="fas fa-cart-plus me-2"></i> Ajouter au panier
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .breadcrumb-item + .breadcrumb-item::before {
        content: "\f105";
        font-family: "Font Awesome 5 Free";
        font-weight: 900;
        color: #adb5bd;
    }

    .text-justify {
        text-align: justify;
    }

    body {
        background-color: #f8f9fa;
    }
</style>